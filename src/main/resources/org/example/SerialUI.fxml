<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="mainPane"
            minHeight="500.0" minWidth="700.0"
            prefHeight="720.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.SerialUIController">

    <!-- ================= 顶部：串口连接 ================= -->
    <top>
        <VBox spacing="12" styleClass="top-bar">

            <!-- 标题行 -->
            <Label text="🔌 串口连接" styleClass="title-label"/>

            <!-- 连接参数行 -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="串口:"/>
                <ComboBox fx:id="portComboBox" prefWidth="120" promptText="选择串口"/>

                <Label text="波特率:"/>
                <ComboBox fx:id="baudRateComboBox" prefWidth="110" promptText="波特率"/>

                <Button fx:id="btnRefresh" onAction="#refreshPorts" text="刷新">
                    <graphic>
                        <FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="设备地址:"/>
                <TextField fx:id="txtDeviceAddress" prefWidth="70"
                           promptText="0~255" text="1"/>
            </HBox>

            <!-- 操作按钮行 + 功能按钮 -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btnOpenPort" onAction="#openSerialPort"
                        text="连接串口" styleClass="button-success">
                    <graphic>
                        <FontIcon iconLiteral="mdi2p-power" iconSize="16"/>
                    </graphic>
                </Button>

                <Button fx:id="btnClosePort" disable="true"
                        onAction="#closeSerialPort"
                        text="断开串口" styleClass="button-danger">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-close-circle" iconSize="16"/>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnParameters" onAction="#showParameters" text="配置查看">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-cog" iconSize="16"/>
                    </graphic>
                </Button>

                <MenuButton fx:id="menuRecords" text="记录查看">
                    <graphic>
                        <FontIcon iconLiteral="mdi2h-history" iconSize="16"/>
                    </graphic>
                    <items>
                        <MenuItem onAction="#showHistoryRecords" text="历史记录"/>
                    </items>
                </MenuButton>

                <Button fx:id="btnOpenDebug" onAction="#openDebugWindow"
                        text="调试窗口" styleClass="button-primary">
                    <graphic>
                        <FontIcon iconLiteral="mdi2b-bug" iconSize="16"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- ================= 中心：仪表盘 ================= -->
    <center>
        <VBox spacing="16" alignment="CENTER"
              style="-fx-padding: 20;">

            <!-- 开度仪表容器 -->
            <StackPane fx:id="gaugeContainer" prefWidth="320" prefHeight="320"/>

            <!-- 数值信息 -->
            <HBox spacing="40" alignment="CENTER"
                  style="-fx-padding: 12 24 12 24;
                     -fx-background-color: white;
                     -fx-background-radius: 8;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">

                <VBox alignment="CENTER" spacing="4">
                    <Label text="实际力矩" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                    <Label fx:id="lblTorque" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="4">
                    <Label text="电机转速" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                    <Label fx:id="lblSpeed" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="4">
                    <Label text="控制方式" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                    <Label fx:id="lblControlMode" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="4">
                    <Label text="阀门状态" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                    <Label fx:id="lblValveState" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- 给定开度 + 控制方式 -->
            <HBox spacing="20" alignment="CENTER">
                <HBox spacing="8" alignment="CENTER">
                    <Label text="给定开度:" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="txtSetOpenRatio" prefWidth="80" promptText="0~100 %"/>
                    <Button fx:id="btnSetOpenRatio" onAction="#setOpenRatio"
                            text="设置" styleClass="button-primary" prefWidth="80">
                        <graphic>
                            <FontIcon iconLiteral="mdi2t-target" iconSize="16"/>
                        </graphic>
                    </Button>
                </HBox>

                <HBox spacing="8" alignment="CENTER">
                    <Label text="控制方式:" style="-fx-font-size: 14px;"/>
                    <ComboBox fx:id="cmbControlMode" prefWidth="120"/>
                    <Button fx:id="btnSetControlMode" onAction="#setControlMode"
                            text="设置" styleClass="button-primary" prefWidth="80">
                        <graphic>
                            <FontIcon iconLiteral="mdi2c-cog-sync" iconSize="16"/>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <!-- 阀门控制按钮 -->
            <HBox spacing="12" alignment="CENTER">
                <Button fx:id="btnOpenValve" onAction="#openValve"
                        text="开阀" styleClass="button-success" prefWidth="100" prefHeight="40">
                    <graphic>
                        <FontIcon iconLiteral="mdi2v-valve-open" iconSize="18"/>
                    </graphic>
                </Button>

                <Button fx:id="btnCloseValve" onAction="#closeValve"
                        text="关阀" styleClass="button-danger" prefWidth="100" prefHeight="40">
                    <graphic>
                        <FontIcon iconLiteral="mdi2v-valve-closed" iconSize="18"/>
                    </graphic>
                </Button>

                <Button fx:id="btnStopValve" onAction="#stopValve"
                        text="停止" prefWidth="100" prefHeight="40">
                    <graphic>
                        <FontIcon iconLiteral="mdi2s-stop-circle" iconSize="18"/>
                    </graphic>
                </Button>

                <Button fx:id="btnResetAlarm" onAction="#resetAlarm"
                        text="复归" prefWidth="100" prefHeight="40">
                    <graphic>
                        <FontIcon iconLiteral="mdi2r-restore" iconSize="18"/>
                    </graphic>
                </Button>
            </HBox>

        </VBox>
    </center>
</BorderPane>