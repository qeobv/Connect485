<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="mainPane"
            minHeight="400.0" minWidth="600.0"
            prefHeight="720.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.SerialUIController">

    <!-- ================= 顶部：串口连接 ================= -->
    <top>
        <VBox spacing="12" style="-fx-padding: 16;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="串口:" />
                <ComboBox fx:id="portComboBox" prefWidth="120" promptText="选择串口" />

                <Label text="波特率:" />
                <ComboBox fx:id="baudRateComboBox" prefWidth="110" promptText="波特率" />

                <Button fx:id="btnRefresh" onAction="#refreshPorts" text="刷新">
                    <graphic>
                        <FontIcon iconLiteral="mdi2r-refresh" iconSize="16" />
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <Label text="设备地址:" />
                <TextField fx:id="txtDeviceAddress" prefWidth="70"
                           promptText="0~255" text="1" />
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btnOpenPort" onAction="#openSerialPort"
                        text="连接串口" styleClass="button-success">
                    <graphic>
                        <FontIcon iconLiteral="mdi2p-power-plug" iconSize="16" />
                    </graphic>
                </Button>

                <Button fx:id="btnClosePort" disable="true"
                        onAction="#closeSerialPort"
                        text="断开串口" styleClass="button-danger">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-close-circle" iconSize="16" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- ================= 中心：接收区 ================= -->
    <center>
        <VBox spacing="12" style="-fx-padding: 0 16 0 16;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="数据接收" style="-fx-font-size: 15px; -fx-font-weight: bold;" />

                <Region HBox.hgrow="ALWAYS" />

                <MenuButton fx:id="menuRecords" text="记录查看">
                    <graphic>
                        <FontIcon iconLiteral="mdi2h-history" iconSize="16" />
                    </graphic>
                    <items>
                        <MenuItem onAction="#showHistoryRecords" text="历史记录" />
                    </items>
                </MenuButton>

                <Button fx:id="btnParameters" onAction="#showParameters" text="配置查看">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-cog" iconSize="16" />
                    </graphic>
                </Button>

                <Button fx:id="btnClearRecv" onAction="#clearRecvText" text="清空显示">
                    <graphic>
                        <FontIcon iconLiteral="mdi2d-delete-sweep" iconSize="16" />
                    </graphic>
                </Button>

                <Button fx:id="btnOpenDebug" onAction="#openDebugWindow"
                        text="调试窗口" styleClass="button-primary">
                    <graphic>
                        <FontIcon iconLiteral="mdi2b-bug" iconSize="16" />
                    </graphic>
                </Button>
            </HBox>

            <TextArea fx:id="txtRecvArea" editable="false"
                      wrapText="true" VBox.vgrow="ALWAYS"
                      style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px;" />
        </VBox>
    </center>

    <!-- ================= 底部：发送区 ================= -->
    <bottom>
        <VBox spacing="10" style="-fx-padding: 12 16 16 16;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="快捷发送" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnImportData" onAction="#importTxtData" text="导入报文">
                    <graphic>
                        <FontIcon iconLiteral="mdi2f-file-import" iconSize="16" />
                    </graphic>
                </Button>

                <Button fx:id="btnExportData" onAction="#exportTxtData" text="导出业务数据">
                    <graphic>
                        <FontIcon iconLiteral="mdi2e-export" iconSize="16" />
                    </graphic>
                </Button>
            </HBox>

            <TextArea fx:id="txtSendData"
                      promptText="输入要发送的HEX指令(如: 01 64 00 00 00 00)，默认带CRC校验"
                      wrapText="true" prefRowCount="4"
                      style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px;" />

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button fx:id="btnSend" onAction="#sendData"
                        text="发 送" styleClass="button-primary"
                        prefWidth="120">
                    <graphic>
                        <FontIcon iconLiteral="mdi2s-send" iconSize="16" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>