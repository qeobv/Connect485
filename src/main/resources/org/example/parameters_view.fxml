<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ParametersView">
   <padding>
      <Insets bottom="16" left="16" right="16" top="16" />
   </padding>

   <!-- ============ 顶部工具栏 ============ -->
   <HBox alignment="CENTER_LEFT" spacing="10">
      <Label text="参数配置" style="-fx-font-size: 15px; -fx-font-weight: bold;" />

      <Region HBox.hgrow="ALWAYS" />

      <Button fx:id="btnRefresh" onAction="#handleRefresh" text="刷新">
         <graphic>
            <FontIcon iconLiteral="mdi2r-refresh" iconSize="16" />
         </graphic>
      </Button>

      <Button fx:id="btnClear" onAction="#handleClear" text="清空">
         <graphic>
            <FontIcon iconLiteral="mdi2d-delete-sweep" iconSize="16" />
         </graphic>
      </Button>
   </HBox>

   <!-- ============ 当前参数显示区 ============ -->
   <Label text="当前参数" style="-fx-font-size: 13px; -fx-text-fill: -color-fg-muted;" />
   <TableView fx:id="configTable" prefHeight="260.0" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="categoryColumn" prefWidth="120" text="类别"/>
         <TableColumn fx:id="nameColumn" prefWidth="200" text="参数名称"/>
         <TableColumn fx:id="valueColumn" prefWidth="200" text="参数值"/>
      </columns>
   </TableView>

   <HBox alignment="CENTER_LEFT" spacing="10">
      <Button fx:id="btnDownload" onAction="#handleDownload"
              text="下载配置" styleClass="button-primary">
         <graphic>
            <FontIcon iconLiteral="mdi2d-download" iconSize="16" />
         </graphic>
      </Button>
      <Region HBox.hgrow="ALWAYS" />
   </HBox>

   <!-- ============ 待上传参数编辑区 ============ -->
   <Label text="待上传参数" style="-fx-font-size: 13px; -fx-text-fill: -color-fg-muted;" />
   <TextArea fx:id="txtParameters1"
             prefHeight="150.0"
             wrapText="true"
             VBox.vgrow="ALWAYS"
             style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px;" />

   <HBox alignment="CENTER_RIGHT" spacing="10">
      <Button fx:id="btnUpload" onAction="#handleUpload" text="上传配置">
         <graphic>
            <FontIcon iconLiteral="mdi2u-upload" iconSize="16" />
         </graphic>
      </Button>

      <Button fx:id="btnUpload1" onAction="#handleSend"
              text="发送" styleClass="button-primary">
         <graphic>
            <FontIcon iconLiteral="mdi2s-send" iconSize="16" />
         </graphic>
      </Button>
   </HBox>
</VBox>
