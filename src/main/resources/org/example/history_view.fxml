<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.HistoryRecordController">
   <children>
      <TableView fx:id="recordTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="timeColumn" prefWidth="150" text="时间"/>
            <TableColumn fx:id="contentColumn" prefWidth="400" text="内容"/>
         </columns>
      </TableView>
      <HBox spacing="10" alignment="CENTER_RIGHT">
         <Button onAction="#onRefreshAction" text="刷新"/>
         <Button onAction="#onDownloadAction" text="下载"/>
         <Button onAction="#onCloseAction" text="关闭"/>
      </HBox>
   </children>
</VBox>
