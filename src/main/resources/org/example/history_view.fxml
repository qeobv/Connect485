<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.HistoryRecordController"
      spacing="12">

   <padding>
      <Insets top="16" right="16" bottom="16" left="16"/>
   </padding>

   <!-- ============ 顶部标题栏 ============ -->
   <VBox styleClass="top-bar" spacing="8">
      <HBox alignment="CENTER_LEFT" spacing="10">
         <Label text="历史记录" styleClass="title-label"/>
         <Region HBox.hgrow="ALWAYS"/>
      </HBox>
   </VBox>

   <!-- ============ 表格 ============ -->
   <TableView fx:id="recordTable" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="timeColumn" text="时间" prefWidth="160" minWidth="120"/>
         <TableColumn fx:id="contentColumn" text="内容" prefWidth="600"/>
      </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
      </columnResizePolicy>
   </TableView>

   <!-- ============ 底部按钮 ============ -->
   <HBox spacing="10" alignment="CENTER_RIGHT">
      <Button text="刷新" onAction="#onRefreshAction" prefWidth="90">
         <graphic>
            <FontIcon iconLiteral="mdi2r-refresh" iconSize="16"/>
         </graphic>
      </Button>

      <Button text="下载" onAction="#onDownloadAction" prefWidth="90">
         <graphic>
            <FontIcon iconLiteral="mdi2d-download" iconSize="16"/>
         </graphic>
      </Button>

      <Button text="关闭" onAction="#onCloseAction"
              prefWidth="90" styleClass="button-danger">
         <graphic>
            <FontIcon iconLiteral="mdi2c-close" iconSize="16"/>
         </graphic>
      </Button>
   </HBox>
</VBox>